<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluesky's public API and image CDN. Photos are checked on device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Label tab: the tab and badges over Bluesky, and the screen-capture session behind them. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Settings offer "Open Bluesky" when the app is installed. -->
    <queries>
        <package android:name="xyz.blueskyweb.app" />
    </queries>

    <application
        android:name=".WildcatVerifyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.WildcatVerify">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bluesky's sign-in page redirects here (io.github.vinnyt456:/oauth/callback),
                 the same OAuth client as the iOS app. singleTask closes the browser tab. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.vinnyt456" />
            </intent-filter>
        </activity>

        <!-- Share → "Look Again": like the iOS share extension. Checks one image or
             Bluesky link in memory and shows the result; Done discards everything. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WildcatVerify">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>


        <!-- Label tab: screen capture approved by the user each session (MediaProjection). -->
        <service
            android:name=".autolabel.ScreenLabelService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
