<?xml version="1.0" encoding="utf-8"?>
<!-- Sideload builds only: Google Play restricts accessibility services to accessibility tools. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Auto-Label: badges on photos while browsing Bluesky. Turned on by the user in
             system Settings → Accessibility, after the in-app disclosure. -->
        <service
            android:name=".autolabel.AutoLabelService"
            android:exported="true"
            android:label="@string/auto_label_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_label_service" />
        </service>
    </application>
</manifest>
